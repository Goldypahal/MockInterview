# Copy this file to .env and fill in your key. Never share or upload .env.

# Free key from https://aistudio.google.com/apikey (the same key as Notice Board Saathi works)
GEMINI_API_KEY=<your-gemini-api-key>
GEMINI_MODEL=gemini-2.5-flash
# Each free model has its own daily limit. If one runs out, these are tried in order.
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite,gemini-3.1-flash-lite,gemini-3-flash-preview

# Interviewer voice (gTTS): co.in = Indian English accent. Try co.uk or com for others.
TTS_LANG=en
TTS_TLD=co.in
